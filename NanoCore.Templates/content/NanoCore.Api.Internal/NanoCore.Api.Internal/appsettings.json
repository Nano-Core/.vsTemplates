{
  "App": {
    "Version": "1.0.0.0",
    "Hosting": {
      "Root": "api",
      "Http": {
        "Ports": [
          8080
        ]
      }
    },
    "HttpPolicyHeaders": {
      "ContentType": null,
      "ReferrerPolicy": null,
      "FrameOptions": null,
      "XssProtection": null,
      "Csp": null,
      "Cors": null,
      "Hsts": null,
      "Robots": null,
      "ForwardedHeaders": {
        "Headers": "All",
        "RequireHeaderSymmetry": false
      }
    },
    "ResponseCache": {
      "MaxSize": 1024,
      "MaxBodySize": 102400,
      "MaxAge": "00:20:00"
    },
    "ResponseCompression": {
      "UseGzip": true,
      "UseBrotli": true
    },
    "TimeZone": {
      "DefaultTimeZone": "UTC"
    },
    "Localization": {
      "DefaultCulture": "en-US",
      "SupportedCultures": [
      ]
    },
    "Documentation": {
      "Name": "NanoCore.Api.Internal",
      "HideDefaultVersion": true
    },
    "HealthCheck": {
    },
    "Metrics": {
    },
    "ErrorHandling": {
      "ExposeErrors": false
    }
  }
}
